    "read-excel-file": "^9.3.20",
    "sql.js": "^1.17.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/papaparse": "^5.5.2",
    "@types/sql.js": "^1.16.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "axe-core": "^4.14.1",
    "canvas": "^3.2.3",
