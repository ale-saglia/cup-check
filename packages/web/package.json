  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage --reporter=default --reporter=junit --outputFile.junit=junit.xml",
